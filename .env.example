# Settings the Prometheus server reads from its environment. The server does not load this file:
# set the variables in your shell (PowerShell: $env:NAME = 'value') before `npm start`.

# Required: Meta Model API key, used by the server only.
META_API_KEY=
# local = run the detector and depth workers on this machine (the demo setup); cloud is the default.
PROMETHEUS_COMPUTE_PROFILE=local

# --- Optional overrides (defaults shown) ---

# Model and effort per Muse Spark task: muse-spark-1.1 | 1.2 | 1.3, effort minimal | low | medium | high.
PROMETHEUS_NAMER_MODEL=muse-spark-1.2
PROMETHEUS_NAMER_EFFORT=minimal
PROMETHEUS_PREDICT_MODEL=muse-spark-1.2
PROMETHEUS_PREDICT_EFFORT=minimal
PROMETHEUS_PLACE_MODEL=muse-spark-1.2
PROMETHEUS_PLACE_EFFORT=minimal
# Scenario reasoner on the earlier /classic page.
PROMETHEUS_SPARK_MODEL=muse-spark-1.3
PROMETHEUS_SPARK_EFFORT=minimal

# Rate limits per provider lane: calls per minute and estimated USD per minute (not a billing cap).
PROMETHEUS_SAM_CALLS_PER_MINUTE=120
PROMETHEUS_SAM_BUDGET_PER_MINUTE=0.5
PROMETHEUS_NAMER_CALLS_PER_MINUTE=30
PROMETHEUS_NAMER_BUDGET_PER_MINUTE=0.5
PROMETHEUS_PREDICT_CALLS_PER_MINUTE=60
PROMETHEUS_PREDICT_BUDGET_PER_MINUTE=1
# Shared lane used by the /classic page.
PROMETHEUS_PROVIDER_BUDGET_PER_MINUTE=1

# Local workers: Python interpreter (default .asset-tmp/depth-runtime/venv312) and detector checkpoint.
PROMETHEUS_DETECT_PYTHON=
PROMETHEUS_DETECT_MODEL=PekingU/rtdetr_v2_r18vd
PROMETHEUS_DEPTH_PYTHON=

# Remote GPU workers over a loopback SSH tunnel (see docs/colab-system-gpu.md).
PROMETHEUS_DEPTH_BACKEND=
PROMETHEUS_DEPTH_REMOTE_URL=
PROMETHEUS_GAZE_REMOTE_URL=

# Optional local HTTPS (see docs/archive/README_ko_20261101.md for creating the certificate).
PROMETHEUS_HTTPS_CERT=
PROMETHEUS_HTTPS_KEY=
